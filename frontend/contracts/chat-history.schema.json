{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iarf.local/contracts/chat-history.schema.json",
  "title": "IARF paginated chat history",
  "type": "object",
  "required": [
    "session",
    "items",
    "next_cursor",
    "has_more",
    "debug"
  ],
  "properties": {
    "session": {
      "type": "object",
      "required": [
        "id",
        "title",
        "message_count",
        "newest_message_id",
        "revision",
        "assistant_scope",
        "interactions",
        "stats"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "created_at": { "type": ["string", "null"] },
        "updated_at": { "type": ["string", "null"] },
        "message_count": { "type": "integer", "minimum": 0 },
        "newest_message_id": { "type": ["integer", "null"] },
        "revision": { "type": "string" },
        "assistant_scope": { "type": "object" },
        "interactions": {
          "type": "array",
          "items": { "type": "object" }
        },
        "stats": {
          "type": "object",
          "required": ["cost", "tokens"],
          "properties": {
            "cost": { "type": "number", "minimum": 0 },
            "tokens": {
              "type": "object",
              "required": ["prompt", "completion", "total"],
              "properties": {
                "prompt": { "type": "integer", "minimum": 0 },
                "completion": { "type": "integer", "minimum": 0 },
                "total": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "message_id",
          "sequence",
          "created_at",
          "role"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "message_id": { "type": "integer", "minimum": 1 },
          "sequence": { "type": "integer", "minimum": 0 },
          "created_at": { "type": ["string", "null"] },
          "role": {
            "enum": ["user", "assistant", "event", "developer"]
          },
          "text": { "type": "string" },
          "html": { "type": "string" },
          "attachments": {
            "type": "array",
            "items": { "type": "object" }
          },
          "event": {
            "type": "object",
            "required": ["kind"]
          },
          "developer": {},
          "title": { "type": "string" },
          "tts_audio_url": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "next_cursor": { "type": ["string", "null"] },
    "has_more": { "type": "boolean" },
    "debug": { "type": "boolean" }
  },
  "additionalProperties": false
}
